@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <_BLW_Modell_/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bp: <http://opendata.inra.fr/ATOL/>.

ex:Farmer1 a foaf:Person ;
    rdfs:label "Person Example1";
    foaf:familyname "Muster" ;
    foaf:firstname "Thomas";
    foaf:mbox <mailto:thomasmuster@example.org> ;
    schema:birthDate "1985-06-12"^^xsd:date ;
    foaf:homepage <http://johndoe.example.org> ;
    org:headOf ex:Bauernhof1 .

ex:Bauernhof1 a org:Organization ;
    rdfs:label "Organization Example1";
    org:name ex:Bauernhof1 ;
    ex:owner ex:Farmer1;
    owl:hasKey "UID".

ex:BLW a org:Organization ;
    rdfs:label "Organization Example2";
    org:name "BLW" ;
    owl:hasKey "UID".

ex:individualAnimal a schema:Animal;
    schema:name "".

ex:notificationindividual a ex:Notification ;
    rdfs:label "Notification Example: Individual Animal";
    ex:information ex:cow1 ;
    ex:sendBy ex:Farmer1 ;
    ex:sendTo ex:BLW .

# === Use Case A: Group with individual animal members ===
ex:cow1 a ex:individualAnimal ; schema:name "cow 1" .
