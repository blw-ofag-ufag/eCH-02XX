@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <_HERE_> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix bp: <http://opendata.inra.fr/ATOL/>.
@prefix zusatzInfo: <https://www.ech.ch/de/ech/ech-0261/1.0.0/>.


ex:Person a foaf:Person . 
ex:Organization a org:Organization . 

ex:Farmer1 a ex:Person ;
    rdfs:label "Person Example1";
    foaf:familyname "Muster" ;
    foaf:firstname "Thomas";
    foaf:mbox <mailto:thomasmuster@example.org> ;
    schema:birthDate "1985-06-12"^^xsd:date ;
    foaf:homepage <http://johndoe.example.org> ;
    org:headOf ex:Bauernhof1 .


ex:JaneSmith a foaf:Person ;
    rdfs:label "Person Example2";
    foaf:name "Jane Smith" ;
    foaf:mbox <mailto:janesmith@example.org> ;
    zusatzInfo:bla "aufgabe";
    ex:employedBy ex:Bauernhof1;
    schema:birthDate "1990-03-22"^^xsd:date .


ex:Bauernhof1 a ex:Organization ;
    rdfs:label "Organization Example1";
    org:name "Bauernhof1" ;
    ex:owner ex:Farmer1 ;
    ex:herd ex:GroupA ;
    ex:herd ex:GroupB ;
    ex:individualAnimal ex:cow1, ex:cow2, ex:cow3, ex:cow4, ex:cow5, ex:cow6;
    owl:hasKey "UID".

ex:BLW a ex:Organization ;
    rdfs:label "Organization Example2";
    org:name "BLW" ;
    owl:hasKey "UID".

ex:notificationGroupIndividuals a ex:Notification ;
    rdfs:label "Notification Example1: Group of Animals known individually";
    ex:information ex:GroupA ;
    ex:sendBy ex:Farmer1 ;
    ex:sendTo ex:BLW .

ex:notificationGroupAnonymous a ex:Notification ;
    rdfs:label "Notification Example2: Group of Animals known only as an aggregated Group";
    ex:information ex:GroupA ;
    ex:sendBy ex:Farmer1 ;
    ex:sendTo ex:BLW .

ex:notificationindividual a ex:Notification ;
    rdfs:label "Notification Example: Individual Animal";
    ex:information ex:cow1 ;
    ex:sendBy ex:Farmer1 ;
    ex:sendTo ex:BLW .


# === Use Case A: Group with individual animal members ===

ex:GroupA a foaf:Group ;
    schema:species "Bos taurus" ;  # e.g., gray cow
    foaf:member ex:cow4, ex:cow2, ex:cow3.


# === Use Case B: Group defined by species and count ===

ex:individualAnimal a schema:Animal;
    rdfs:label "Defines an individual animal";
    schema:name ^^schema:name;
    schema:birthDate ^^xsd:date ;.

ex:notificationindividual a ex:Notification ;
    rdfs:label "Notification Example: Individual Animal";
    ex:information ex:cow1 ;
    ex:sendBy ex:Farmer1 ;
    ex:sendTo ex:BLW .

# === entities: Group with individual animal members ===
ex:cow1 a ex:individualAnimal ; schema:name "cow 1" .
ex:cow2 a ex:individualAnimal ; schema:name "cow 2" .
ex:cow3 a ex:individualAnimal ; schema:name "cow 3" .
ex:cow4 a ex:individualAnimal ; schema:name "cow 4" .
ex:cow5 a ex:individualAnimal ; schema:name "cow 5" .
ex:cow6 a ex:individualAnimal ; schema:name "cow 6" .
ex:cow7 a ex:individualAnimal ; schema:name "cow 7" .
ex:cow8 a ex:individualAnimal ; schema:name "cow 8" .
ex:cow9 a ex:individualAnimal ; schema:name "cow 9" .